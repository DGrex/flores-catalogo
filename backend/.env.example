# ============================================
# Copiar este archivo como ".env" y completar
# NUNCA subir el archivo ".env" real a git
# ============================================

# Seguridad
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga-y-unica
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,127.0.0.1,localhost

# Base de datos (PostgreSQL en produccion)
DATABASE_URL=postgres://usuario:password@localhost:5432/flores_db

# CORS - dominios autorizados a consumir la API
CORS_ALLOWED_ORIGINS=https://tu-frontend.com,http://localhost:3000

# Cloudinary (almacenamiento de imagenes fuera del servidor)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# HTTPS / cookies seguras (activar en produccion con dominio real)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=1
